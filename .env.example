# Copy to .env (gitignored) and fill in what you need. Nothing here is required to start —
# with no .env at all, delivery goes to the console and the example employee still runs.

# Where output goes: console | telegram | slack
BEADLE_CHANNEL=console

# Telegram: create a bot with @BotFather, add it to a group, then get the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack: an incoming-webhook URL for one channel
SLACK_WEBHOOK_URL=

# The model used for the JUDGE step. One-shot, tools disabled.
BEADLE_MODEL=claude-sonnet-4-6

# Postgres for lib.sql(). USE A READ-ONLY ROLE. Not a convention — a credential that
# cannot write is the only version of this that survives a bad week.
BEADLE_DSN=

# Used by the example employee only. Comma-separated.
BEADLE_SITES=https://example.com

# Commit runtime state (journal, runs) after each task, so `git log` is a history of what your
# employees did. OFF by default — on a checkout you are editing, it would sweep your in-progress
# work into a commit. Turn on once the employee lives on its own box.
BEADLE_GIT_COMMIT=0

# Fraction of BELOW-threshold runs to send to the judge anyway, as an audit. A gate that doesn't
# trip produces silence, and false negatives are invisible — this is how you find out what your
# thresholds are hiding. 0.02 = 2%. Audit runs are never delivered.
GATE_SAMPLE=0

# example-pr-nag: repos to watch. Needs `gh auth status` to be green. No other credentials.
BEADLE_REPOS=

# example-page-watch: public pages to diff. No credentials at all.
BEADLE_PAGES=
